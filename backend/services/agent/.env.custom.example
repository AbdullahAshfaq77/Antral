# Copy this file to .env.custom and fill in your provider's details.
# The provider must support the OpenAI-compatible /chat/completions API,
# including tool/function calling for agent tools.
CUSTOM_LLM_PROVIDER=My Provider
CUSTOM_LLM_BASE_URL=https://api.example.com/v1
CUSTOM_LLM_API_KEY=replace-with-your-api-key
CUSTOM_LLM_MODEL=provider-model-id

# Optional; leave empty if the provider/model does not support image inputs.
CUSTOM_LLM_VISION_MODEL=
